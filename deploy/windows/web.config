<!--
web.config
==========
OPTIONAL. Only needed if you want the forecasting service reachable at a
normal IIS site (e.g. https://forecast.yourcompany.local or through your
existing IIS/HTTPS setup) instead of people hitting http://server:8000
directly. If everyone accessing this is fine using the raw host:port URL
inside your network, you can skip this file entirely — just run the
Windows Service from install-service.ps1 and hand out that URL.

WHAT THIS DOES:
  Reverse-proxies an IIS site to the uvicorn service running on Port below
  (must match -Port in install-service.ps1), using IIS's Application
  Request Routing (ARR) + URL Rewrite modules.

SETUP:
  1. In IIS Manager, install "Application Request Routing" and
     "URL Rewrite" (via Web Platform Installer or the IIS feature installer)
     if not already present.
  2. In IIS Manager, enable proxy: Server node -> Application Request
     Routing Cache -> Server Proxy Settings -> check "Enable proxy".
  3. Create a new IIS site (or use an existing one) pointing its physical
     path at an EMPTY folder (this web.config can live there) — IIS itself
     serves nothing directly, it only proxies.
  4. Put this file in that site's root folder.
  5. Bind the site to your desired hostname/port and, if needed, an SSL
     certificate for HTTPS.
  6. Make sure the Windows Service from install-service.ps1 is running on
     the PORT referenced below before testing.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToForecastService" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
